{
  "name": "@r_masseater/h56m",
  "version": "0.2.0",
  "description": "A secret scanner engine written in Rust that scans git history, the staged changes or any text with Betterleaks-format rules from a preset, configured from vite.config.ts.",
  "keywords": [
    "betterleaks",
    "gitleaks",
    "preset",
    "secrets",
    "security",
    "tanstack-intent",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/h56m#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT AND CC-BY-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/h56m"
  },
  "bin": {
    "h56m": "./bin/h56m.ts"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "dist",
    "logo.svg",
    "presets",
    "skills/scan-secrets",
    "skills/use-h56m-presets"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./presets": "./src/app/presets.ts",
    "./vite": {
      "types": "./src/app/vite.ts"
    },
    "./native/*": "./native/*",
    "./package.json": "./package.json",
    "./presets/*": "./presets/*"
  },
  "publishConfig": {
    "bin": {
      "h56m": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./presets": {
        "types": "./dist/presets.d.mts",
        "default": "./dist/presets.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json",
      "./presets/*": "./presets/*"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@masseater.dev/lint-host": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "betterleaks": "github:betterleaks/betterleaks#e07e69ba6a441313529b3e72be43ffdcc62bdf86",
    "effect": "catalog:stack",
    "smol-toml": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "vite": "*",
    "vite-plus": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "native": {
    "binary": "h56m",
    "targets": [
      "linux-x64-gnu",
      "win32-x64-msvc"
    ]
  }
}
