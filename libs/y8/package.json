{
  "name": "@r_masseater/y8",
  "version": "0.4.1",
  "description": "A Markdown linter written in Rust that matches markdownlint's built-in rules, configured from vite.config.ts, with TypeScript rules, markdownlint custom-rule support and a Japanese tokenizer.",
  "keywords": [
    "agents-md",
    "lint",
    "markdown",
    "markdownlint",
    "preset",
    "readme",
    "skill-md",
    "tanstack-intent",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/y8#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/y8"
  },
  "bin": {
    "y8": "./bin/y8.ts"
  },
  "files": [
    "LICENSE",
    "dist",
    "logo.svg",
    "skills/apply-y8-presets",
    "skills/lint-markdown"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./presets": "./src/app/presets.ts",
    "./kuromojin": "./src/app/kuromojin.ts",
    "./vite": {
      "types": "./src/app/vite.ts"
    },
    "./native/*": "./native/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "y8": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./presets": {
        "types": "./dist/presets.d.mts",
        "default": "./dist/presets.mjs"
      },
      "./kuromojin": {
        "types": "./dist/kuromojin.d.mts",
        "default": "./dist/kuromojin.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@masseater.dev/lint-host": "workspace:*",
    "@masseater.dev/path-kit": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "markdownlint": "catalog:",
    "minimatch": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "markdownlint": ">=0.42.0",
    "minimatch": ">=11.0.9",
    "vite": "*",
    "vite-plus": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "markdownlint": {
      "optional": true
    },
    "minimatch": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "native": {
    "binary": "y8",
    "targets": [
      "linux-x64-gnu",
      "win32-x64-msvc"
    ]
  }
}
