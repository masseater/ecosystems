{
  "name": "@r_masseater/github-workflow",
  "version": "0.1.1",
  "description": "Helpers for GitHub Actions steps written with Effect: call the repository's GitHub API, write step outputs and warnings, and run commands.",
  "keywords": [
    "actions",
    "effect",
    "github",
    "github-actions",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/github-workflow#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/github-workflow"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/write-actions-steps"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
