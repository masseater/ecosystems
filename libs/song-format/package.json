{
  "name": "@r_masseater/song-format",
  "version": "0.2.0",
  "description": "The .fumx song format: a reader that turns a song into a typed value, key and chord analysis, import from TypeScript with Vite, a language server, MIDI and Ableton Live Set conversion that checks the result against the original, and a song report.",
  "keywords": [
    "fumx",
    "langium",
    "language-server",
    "midi",
    "music",
    "parser",
    "tanstack-intent",
    "vite-plugin"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/song-format#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/song-format"
  },
  "bin": {
    "als-to-fumx": "./bin/als-to-fumx.ts",
    "fumx-language-server": "./bin/fumx-language-server.ts",
    "midi-to-fumx": "./bin/midi-to-fumx.ts",
    "song-report": "./bin/song-report.ts"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/read-fumx",
    "skills/use-fumx-tools"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/mapper.mjs"
  ],
  "imports": {
    "#/*": "./src/*",
    "#generated/*": "./generated/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./analysis": "./src/app/analysis.ts",
    "./language": "./src/app/language.ts",
    "./convert-als": "./src/features/convert-als/index.ts",
    "./convert-midi": "./src/features/convert-midi/index.ts",
    "./vite": "./src/app/vite.ts",
    "./mapper": "./src/app/mapper.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "fumx-language-server": "./dist/fumx-language-server.mjs",
      "midi-to-fumx": "./dist/midi-to-fumx.mjs",
      "song-report": "./dist/song-report.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./analysis": {
        "types": "./dist/analysis.d.mts",
        "default": "./dist/analysis.mjs"
      },
      "./language": {
        "types": "./dist/language.d.mts",
        "default": "./dist/language.mjs"
      },
      "./convert-als": {
        "types": "./dist/convert-als.d.mts",
        "default": "./dist/convert-als.mjs"
      },
      "./convert-midi": {
        "types": "./dist/convert-midi.d.mts",
        "default": "./dist/convert-midi.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./mapper": "./dist/mapper.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ableton-als": "catalog:",
    "fast-xml-parser": "catalog:",
    "langium": "catalog:",
    "midi-file": "catalog:",
    "tonal": "catalog:",
    "vscode-languageserver": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/vitest": "catalog:",
    "@r_masseater/mapped-import": "workspace:^",
    "@r_masseater/node-main": "workspace:*",
    "@r_masseater/song-format": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "langium-cli": "catalog:",
    "ts-content-mapper": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@effect/platform-node": ">=4.1.5",
    "@effect/platform-node-shared": ">=4.1.5",
    "@r_masseater/mapped-import": "workspace:^",
    "effect": "^4.1.0",
    "ts-content-mapper": ">=0.1.1",
    "vite-plus": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/platform-node-shared": {
      "optional": true
    },
    "@r_masseater/mapped-import": {
      "optional": true
    },
    "ts-content-mapper": {
      "optional": true
    }
  },
  "typescript": {
    "contentMapper": {
      "compilerOptions": [],
      "dynamicConfig": false,
      "exec": [
        "node",
        "--input-type=module",
        "-e",
        "import \"@r_masseater/song-format/mapper\""
      ]
    }
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
