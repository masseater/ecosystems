{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "pin",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "342306539+masseater-manager[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "peerDependencies は利用側との互換の範囲を宣言するもので、版を選ばない。範囲のまま広げる。",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "overrides は推移的な依存の下限を強制するもので、範囲のまま置き換える。",
      "matchDepTypes": ["pnpm-workspace.overrides", "pnpm.overrides", "overrides"],
      "rangeStrategy": "replace"
    },
    {
      "description": "msch は版が上がるたびに検査が増え、利用側は同じ変更で移行しないと main の verify が落ちる（msch 0.60.1 の #1703 で masseater.dev の main が赤になった）。bump だけを自動マージしない。bump と移行を同じ PR で出す。",
      "matchPackageNames": ["@r_masseater/msch"],
      "groupName": "msch",
      "automerge": false
    },
    {
      "description": "持ち主自身が公開するパッケージは待たせない。公開した版を、公開した直後に取り込む。",
      "matchPackageNames": ["@r_masseater/**"],
      "minimumReleaseAge": null
    }
  ]
}
