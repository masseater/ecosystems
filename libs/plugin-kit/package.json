{
  "name": "@r_masseater/plugin-kit",
  "version": "0.2.0",
  "description": "Shared code for Claude Code plugin hooks and scripts: read untrusted JSON without throwing and find the plugin cache folder.",
  "keywords": [
    "claude-code",
    "hooks",
    "json",
    "plugin",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/plugin-kit#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/plugin-kit"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/find-cache-folder",
    "skills/read-hook-input"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
