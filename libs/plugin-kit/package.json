{
  "name": "@r_masseater/plugin-kit",
  "version": "0.1.0",
  "description": "Reads untrusted JSON in Claude Code plugin hooks and scripts: tell a plain object from other values and parse text without throwing.",
  "keywords": [
    "claude-code",
    "hooks",
    "json",
    "plugin",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/plugin-kit#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/plugin-kit"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/read-hook-input"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('npm publish leaves catalog: in dependencies. Publish the tarball from vp pm pack instead.'); process.exit(1) }\" && vp run build"
  },
  "devDependencies": {
    "vite-plus": "catalog:stack"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
