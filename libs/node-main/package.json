{
  "name": "@r_masseater/node-main",
  "version": "0.1.0",
  "description": "Runs an Effect program as a Node.js entry point with the Node services, an HTTP client and OTLP tracing already provided.",
  "keywords": [
    "effect",
    "node",
    "opentelemetry",
    "tanstack-intent",
    "tracing"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/node-main#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/node-main"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/run-effect-main"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp exec msch-publish prepublish ."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
