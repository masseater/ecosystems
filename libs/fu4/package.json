{
  "name": "@r_masseater/fu4",
  "version": "0.3.0",
  "description": "The engine of a GitHub Actions linter: Rust parses workflows and TypeScript rules from its presets subpath check them, configured from vite.config.ts.",
  "keywords": [
    "actionlint",
    "github-actions",
    "lint",
    "shellcheck",
    "tanstack-intent",
    "vite-plus",
    "zizmor"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/fu4#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/fu4"
  },
  "bin": {
    "fu4": "./bin/fu4.ts"
  },
  "files": [
    "LICENSE",
    "dist",
    "logo.svg",
    "skills/apply-fu4-presets",
    "skills/lint-workflows"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./presets": "./src/app/presets.ts",
    "./vite": {
      "types": "./src/app/vite.ts"
    },
    "./native/*": "./native/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "fu4": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./presets": {
        "types": "./dist/presets.d.mts",
        "default": "./dist/presets.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@masseater.dev/lint-host": "workspace:*",
    "@masseater.dev/path-kit": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "hast-util-from-html": "catalog:",
    "hast-util-select": "catalog:",
    "liquidjs": "catalog:",
    "mdast-util-to-string": "catalog:",
    "minimatch": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:stack",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "vite": "*",
    "vite-plus": ">=1.8.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "native": {
    "binary": "fu4",
    "targets": [
      "linux-x64-gnu",
      "win32-x64-msvc"
    ]
  }
}
