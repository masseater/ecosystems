{
  "name": "@r_masseater/mapped-import",
  "version": "0.1.0",
  "description": "Imports files in your own format from TypeScript: map a file to source segments for editor features, and turn it into a module with a Vite plugin.",
  "keywords": [
    "content-mapper",
    "import",
    "tanstack-intent",
    "typescript",
    "vite-plugin"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/mapped-import#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/mapped-import"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/import-custom-format"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/entities/segment/index.ts",
    "./mapper": "./src/features/map-content/index.ts",
    "./vite": "./src/features/import-content/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./mapper": {
        "types": "./dist/mapper.d.mts",
        "default": "./dist/mapper.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp exec msch-publish prepublish ."
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "ts-content-mapper": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@effect/platform-node": ">=4.1.5",
    "effect": "^4.1.0",
    "ts-content-mapper": ">=0.1.1",
    "vite-plus": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "ts-content-mapper": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
