{
  "name": "@r_masseater/i68",
  "version": "0.2.0",
  "description": "A linter for .fumx songs that checks musical rules such as notes outside the key, part ranges, voicing clashes and parallel fifths, configured from vite.config.ts with rules written in TypeScript.",
  "keywords": [
    "fumx",
    "lint",
    "music",
    "music-theory",
    "preset",
    "tanstack-intent",
    "vite-plus",
    "voicing"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/i68#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/i68"
  },
  "bin": {
    "i68": "./bin/i68.ts"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/lint-songs",
    "skills/use-i68-presets"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./presets": "./src/app/presets.ts",
    "./habits": "./src/app/habits.ts",
    "./vite": {
      "types": "./src/app/vite.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "i68": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./presets": {
        "types": "./dist/presets.d.mts",
        "default": "./dist/presets.mjs"
      },
      "./habits": {
        "types": "./dist/habits.d.mts",
        "default": "./dist/habits.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@r_masseater/song-format": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@masseater.dev/lint-host": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "tonal": "catalog:",
    "verovio": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "tonal": ">=6.9.0",
    "vite": "*",
    "vite-plus": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "tonal": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
