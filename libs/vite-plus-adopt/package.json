{
  "name": "@r_masseater/vite-plus-adopt",
  "version": "0.14.0",
  "description": "Adopt h56m secret scanning, commitlint, textlint, fallow and dependency checks into Vite+ through the settings in vite.config.ts, and ship @arethetypeswrong/core for TypeScript 7.",
  "keywords": [
    "arethetypeswrong",
    "attw",
    "commitlint",
    "h56m",
    "tanstack-intent",
    "textlint",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/ecosystems/tree/main/libs/vite-plus-adopt#readme",
  "bugs": {
    "url": "https://github.com/masseater/ecosystems/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/ecosystems.git",
    "directory": "libs/vite-plus-adopt"
  },
  "bin": {
    "vpa": "./dist/cli.mjs"
  },
  "files": [
    "THIRD-PARTY-NOTICES",
    "dist",
    "skills/configure-checks"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#attw-upstream/*": "./upstream/attw-core/lib/*",
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./attw": {
      "types": "./dist/attw.d.mts",
      "default": "./dist/attw.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp exec msch-publish prepublish ."
  },
  "dependencies": {
    "@commitlint/format": "catalog:",
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@commitlint/types": "catalog:",
    "@pnpm/logger": "catalog:",
    "@pnpm/workspace.projects-reader": "catalog:",
    "@pnpm/workspace.workspace-manifest-reader": "catalog:",
    "@r_masseater/h56m": "workspace:*",
    "@r_masseater/node-main": "workspace:*",
    "@textlint/config-loader": "catalog:",
    "@textlint/kernel": "catalog:",
    "@textlint/utils": "catalog:",
    "minimatch": "catalog:",
    "semver": "catalog:",
    "textlint": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@andrewbranch/untar.js": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@loaderkit/resolve": "catalog:",
    "@masseater.dev/path-kit": "workspace:*",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "cjs-module-lexer": "catalog:",
    "effect": "catalog:stack",
    "fflate": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:stack",
    "validate-npm-package-name": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@andrewbranch/untar.js": ">=1.0.4",
    "@loaderkit/resolve": ">=1.0.6",
    "cjs-module-lexer": ">=2.3.0",
    "effect": "^4.1.0",
    "fflate": ">=0.8.3",
    "typescript": ">=7.1.0-beta",
    "validate-npm-package-name": ">=8.0.0",
    "vite": "*",
    "vite-plus": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@andrewbranch/untar.js": {
      "optional": true
    },
    "@loaderkit/resolve": {
      "optional": true
    },
    "cjs-module-lexer": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "validate-npm-package-name": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "tools",
      "path": [
        "dist/*.mjs",
        "!dist/attw.mjs"
      ],
      "limit": "15600 B"
    },
    {
      "name": "attw",
      "path": "dist/attw.mjs",
      "limit": "47557 B"
    }
  ],
  "engines": {
    "node": ">=26.13.1"
  }
}
