{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "production": true,
  "entry": ["*/*/bin/*.ts"],
  "dynamicallyLoaded": [
    "**/*.d.*.ts",
    "libs/oxlint-typed-rules/src/shared/lib/ts-api-utils.ts",
    "libs/oxlint-typed-rules/src/shared/lib/ts-compat.ts",
    "libs/oxlint-typed-rules/src/shared/lib/typescript-eslint-utils.ts",
    "libs/vite-plus-adopt/src/shared/lib/typescript/compiler-hosts.ts",
    "libs/vite-plus-adopt/src/shared/lib/typescript/index.ts",
  ],
  "usedClassMembers": [
    { "implements": "LegacySymbol", "members": ["getName", "getDeclarations"] },
    {
      "implements": "LegacyType",
      "members": [
        "symbol",
        "aliasSymbol",
        "types",
        "getSymbol",
        "getProperty",
        "getProperties",
        "getCallSignatures",
      ],
    },
  ],
  "ignoreExports": [{ "file": "**/generated/**", "exports": ["*"] }],
  "overrides": [{ "files": ["**/generated/**"], "rules": { "unused-enum-members": "off" } }],
  "ignoreDependencies": ["@effect/language-service", "fallow-similar-code", "oxlint-tsgolint"],
  "workspaces": {
    "settings": {
      "libs/h56m-presets": {
        "ignoreDependencies": ["betterleaks"],
      },
      "libs/msch": {
        "ignoreDependencies": ["oxlint-plugin-eslint"],
      },
      "libs/oxlint-typed-rules": {
        "ignoreDependencies": [
          "@tsconfig/strictest",
          "@types/react",
          "@typescript-eslint/parser",
          "@typescript-eslint/typescript-estree",
          "combinate",
          "dedent",
        ],
      },
      "libs/vite-plus-adopt": {
        "ignoreDependencies": [
          "@andrewbranch/untar.js",
          "@loaderkit/resolve",
          "cjs-module-lexer",
          "fflate",
          "validate-npm-package-name",
        ],
      },
    },
  },
  "boundaries": {
    "zones": [
      { "name": "tests", "patterns": ["**/*.test.*", "**/*.test.*.*"] },
      { "name": "libs", "patterns": ["libs/**"] },
      { "name": "tools", "patterns": ["tools/**"], "autoDiscover": ["tools"] },
    ],
    "rules": [
      { "from": "libs", "allow": [] },
      { "from": "tools", "allow": ["libs"] },
    ],
  },
  "typeAware": { "enabled": true, "require": "complete" },
  "ignoreExportsUsedInFile": true,
  "failOnParseError": true,
  "ignorePatterns": [
    ".claude/**",
    "libs/fu4-presets/src/**/fixtures/**",
    "libs/oxlint-plugin-decision/example*/**",
    "libs/oxlint-typed-rules/upstream/{react,tanstack-query,tanstack-router,drizzle,remotion}/**",
    "libs/vite-plus-adopt/upstream/**",
    "libs/textlint-rule-preset-ja/upstream/**",
  ],
  "audit": { "gate": "all" },
  "security": {
    "categories": {
      "include": [
        "angular-trusted-html",
        "cleartext-transport",
        "code-injection",
        "command-injection",
        "dangerous-html",
        "deprecated-cipher",
        "dom-document-write",
        "dynamic-module-load",
        "dynamic-regex",
        "electron-unsafe-webpreferences",
        "hardcoded-secret",
        "header-injection",
        "insecure-cookie",
        "insecure-randomness",
        "insecure-temp-file",
        "jquery-html",
        "jwt-alg-none",
        "jwt-verify-missing-algorithms",
        "llm-call-injection",
        "mass-assignment",
        "mysql-multiple-statements",
        "nextjs-open-redirect",
        "nosql-injection",
        "open-redirect",
        "path-traversal",
        "permissive-cors",
        "postmessage-wildcard-origin",
        "prototype-pollution",
        "redos-regex",
        "resource-amplification",
        "route-send-file",
        "secret-pii-log",
        "secret-to-network",
        "sql-injection",
        "ssrf",
        "ssti",
        "template-escape-bypass",
        "tls-validation-disabled",
        "unsafe-buffer-alloc",
        "unsafe-deserialization",
        "weak-crypto",
        "webview-injection",
        "world-writable-permission",
        "xpath-injection",
        "xxe",
        "zip-slip",
      ],
    },
  },
  "health": {
    "ignore": ["**/generated/**"],
  },
  "duplicates": {
    "threshold": 1,
    "ignore": ["**/generated/**", "**/routeTree.gen.ts"],
  },
  "flags": {
    "sdkPatterns": [
      { "function": "getBooleanValue", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getStringValue", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getNumberValue", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getObjectValue", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getBooleanDetails", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getStringDetails", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getNumberDetails", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getObjectDetails", "nameArg": 0, "provider": "OpenFeature" },
      { "function": "getBoolean", "nameArg": 0, "provider": "OpenFeature (Effect service)" },
    ],
  },
  "framework": [
    {
      "name": "vite-plus",
      "enablers": ["vite-plus"],
      "entryPoints": ["vite.config.ts"],
      "toolingDependencies": ["@ast-grep/cli", "eslint-plugin-no-comments", "publint"],
    },
    {
      "name": "vite-plus-adopt",
      "enablers": ["@r_masseater/msch"],
      "toolingDependencies": [
        "@commitlint/config-conventional",
        "@textlint-ja/textlint-rule-preset-ai-writing",
        "textlint-rule-preset-ja-technical-writing",
      ],
    },
    {
      "name": "oxlint-plugin-decision",
      "enablers": ["@r_masseater/msch"],
      "entryPoints": ["decision-rules.ts"],
    },
    {
      "name": "skills",
      "enablers": ["skills"],
      "configPatterns": ["skills-lock.json"],
      "toolingDependencies": ["skills"],
    },
    {
      "name": "tanstack-intent",
      "enablers": ["@tanstack/intent"],
      "configPatterns": [".intent/hooks/*.mjs"],
      "toolingDependencies": ["@tanstack/intent"],
    },
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
  },
}
