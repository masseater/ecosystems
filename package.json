{
  "name": "ecosystems",
  "version": "0.0.1",
  "private": true,
  "description": "masseater's published toolchain: the linters and their presets, the fumx parser, msch and vite-plus-adopt.",
  "author": {
    "name": "masseater",
    "url": "https://github.com/masseater"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint --tsrs && msch --prepare"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:stack",
    "@r_masseater/msch": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "fallow": "catalog:stack",
    "fallow-similar-code": "catalog:stack",
    "fallow-type-aware": "catalog:stack",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "v26.13.1"
  },
  "intent": {
    "skills": [
      "fallow",
      "workspace:@r_masseater/msch"
    ]
  }
}
